<Window
    x:Class="SimRigMode.TrayFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:SimRigMode.UI">

    <Grid x:Name="Root" RequestedTheme="Dark" KeyDown="Root_KeyDown" PreviewKeyDown="Root_PreviewKeyDown">
        <!-- A deep tint over the acrylic, darker towards the bottom. -->
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#D9171A22" Offset="0"/>
                    <GradientStop Color="#EE0C0E13" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>
        <!-- A soft light in the colour of the active mode; the switch drives it. -->
        <Grid x:Name="Ambient" Height="250" VerticalAlignment="Top" IsHitTestVisible="False"/>

        <StackPanel x:Name="Body" Padding="20,16,20,22">
            <Grid Height="32">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ui:PitlaneMark Width="24" Height="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Pitlane" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- The way into the full app: a quiet link, not a button that competes with the switch. -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Height="28" Padding="10,0" Margin="0,0,-6,0" TabIndex="1"
                        CornerRadius="8" Background="Transparent" BorderThickness="0" Click="Open_Click"
                        ToolTipService.ToolTip="Open Pitlane" AutomationProperties.Name="Open Pitlane">
                    <StackPanel Orientation="Horizontal" Spacing="6" Opacity="0.66">
                        <TextBlock Text="Open" FontSize="12" VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE8A7;" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Margin="2,22,0,0" Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Grid Width="10" Height="10" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusHalo" Width="10" Height="10" Fill="#FF34D399" Opacity="0.3"/>
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#FF34D399"/>
                    </Grid>
                    <TextBlock x:Name="StatusText" Text="Active" FontSize="12" Opacity="0.62" VerticalAlignment="Center"/>
                    <Border x:Name="DryRunBadge" Visibility="Collapsed" Margin="2,0,0,0" VerticalAlignment="Center"
                            CornerRadius="8" Padding="7,1" Background="#1FFFB547" BorderBrush="#40FFB547" BorderThickness="1">
                        <TextBlock x:Name="DryRunBadgeText" Text="Dry run" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFC46B"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="ModeTitle" Text="Desktop" FontSize="30" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display" CharacterSpacing="-10"/>
            </StackPanel>

            <ui:HoldSwitch x:Name="Switch" Margin="0,18,0,0" TabIndex="0"/>
            <TextBlock x:Name="Caption" Margin="8,12,8,0" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxLines="3" FontSize="12" Opacity="0.6"/>
        </StackPanel>
    </Grid>
</Window>
